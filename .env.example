# PostgreSQL connection string (keep secret; never commit a real .env)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/se_survey?schema=public"

# Secret used to sign admin session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
ADMIN_SESSION_SECRET="replace-with-a-long-random-secret"

# Optional: institutional Student ID rule (JavaScript RegExp source, applied to the upper-cased ID)
# NEXT_PUBLIC_STUDENT_ID_PATTERN="^[A-Z0-9]{6,12}$"

# Optional: set to "true" only when running behind a trusted reverse proxy that sets X-Forwarded-For
TRUST_PROXY="false"
